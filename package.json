{
  "name": "awesome-emulator-cli",
  "version": "0.6.15",
  "description": "Run tests for AWS SDKs in any language; the CLI manages the local emulator in Docker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "awesome-emulator": "./bin/awesome-emulator.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.js",
    "build": "tsc -p tsconfig.json",
    "build:coverage-tools": "tsc -p tsconfig.coverage.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "npm run build:coverage-tools && node --experimental-test-module-mocks --test",
    "test:integration": "node --test test/integration.test.js",
    "coverage": "npm run build && npm run build:coverage-tools && node .coverage-tools/scripts/coverage/run-coverage.js",
    "prepare": "npm run build",
    "check:release-version": "node scripts/check-release-version.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c19yamamoto/awesome-emulator-cli.git"
  },
  "homepage": "https://github.com/c19yamamoto/awesome-emulator-cli#readme",
  "bugs": {
    "url": "https://github.com/c19yamamoto/awesome-emulator-cli/issues"
  },
  "keywords": [
    "aws",
    "aws-sdk",
    "emulator",
    "local-development",
    "testing",
    "integration-tests"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "magic-string": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
